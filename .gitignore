# ===== Voix -> MIDI — ignorer tout ce qui n'est pas une source =====

# --- Environnements virtuels ---
.venv/
venv/
env/
.venv.*/
ENV/

# --- Cache Python ---
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
*.egg-info/
.eggs/

# --- Build / distribution ---
build/
dist/
wheels/
*.whl
pip-wheel-metadata/

# --- Couverture & outils qualité ---
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml

# --- Freebuff (données locales de l'assistant) ---
.freebuff/

# --- Artefacts audio générés (analyse, démo, tests) ---
*.wav
*.mp3
*.flac
*.ogg
*.m4a
*.aac
*.mid
*.midi
/live_*
prises_live/

# --- Sorties d'analyse : partitions + rapports (export_result) ---
# Tout ce que le pipeline écrit avec un préfixe arbitraire :
# .musicxml / .pdf (gravure MuseScore-LilyPond) / .json / .csv
*.musicxml
*.pdf
*.json
*.csv
# NB : le repo ne versionne aucun .json/.csv/.pdf aujourd'hui ; si un jour
# un fichier de config JSON doit être suivi, le négocier ici avec un !.

# exceptions : garder un éventuel audio d'exemple versionné, et la référence
# des artefacts de test (tests/reference/artifacts.json, voir AGENTS.md) :
# c'est une empreinte, pas une sortie d'analyse — elle doit être versionnée.
!tests/data/*.wav
!tests/reference/*.json

# --- IDE / éditeurs ---
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- Docker (fichiers locaux, images exportées) ---
*.tar
docker-compose.override.yml

# --- Notes personnelles ---
*.log

# --- Exécution locale (fichiers racine jetables de validation) ---
/demo_out.*
/test68.*
/demo_docker.*
/demo_t1.*
/demo_t2.*
/demo_dbg.*
/_ours.pdf
/_via_py.pdf
# captures et logs temporaires des vérifications GUI / PDF
/shot_*.png
/_*.txt
/_dbg.log
