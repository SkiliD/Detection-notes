# ===== Voix -> MIDI — ignore everything that is not a source =====
# Guided results review keeps no persistent state or generated output.

# --- Virtual environments ---
.venv/
venv/
env/
.venv.*/
ENV/

# --- Python cache ---
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
*.egg-info/
.eggs/

# --- Build / distribution ---
build/
dist/
wheels/
*.whl
pip-wheel-metadata/

# --- Coverage & quality tools ---
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml

# --- Freebuff (assistant local data) ---
.freebuff/

# --- Generated audio artifacts (analysis, demo, tests) ---
# Live take folders include immutable automatic/corrected reading archives.
*.wav
*.mp3
*.flac
*.ogg
*.m4a
*.aac
*.mid
*.midi
/live_*
prises_live/
# persisted vocal observations (analysis and replay share <take>.observation.npz)
*.npz

# --- Analysis outputs: scores + reports (export_result) ---
# Everything the pipeline writes with an arbitrary prefix:
# .musicxml / .pdf (MuseScore-LilyPond engraving) / .json / .csv
# Coherence, intonation registers, closed labels and live/final rates share these outputs.
*.musicxml
*.pdf
*.json
*.csv
# NB: the repo tracks no .json/.csv/.pdf today; should a JSON config file
# ever be tracked, negotiate it here with a !.

# exceptions: keep a possibly versioned sample audio, and the test
# artifacts reference (tests/reference/artifacts.json, see AGENTS.md):
# it is a fingerprint, not an analysis output — it must be tracked.
!tests/data/*.wav
!tests/reference/*.json
# the web page's own sources: its two-language labels and the conformance
# cases the JavaScript port replays (web/, see AGENTS.md)
!/web/strings.json
!/web/test/cases.json
!/web/test/yin.json
!/web/test/yin-rates.json
# NB: demo.wav stays ignored (make_demo.py regenerates it), so yin.json and
# yin-rates.json are the committed half of those comparisons and must NEVER be
# ignored.

# --- IDE / editors ---
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- Docker (local files, exported images) ---
*.tar
docker-compose.override.yml

# --- Personal notes ---
*.log

# --- Local runs (throwable root validation files) ---
/demo_out.*
/test68.*
/demo_docker.*
/demo_t1.*
/demo_t2.*
/demo_dbg.*
/_ours.pdf
/_via_py.pdf
# temporary captures and logs of the GUI / PDF checks (including home-screen layout)
/shot_*.png
# the Pages workflow's 1600 px screenshot (web/test/wide-shot.mjs)
/wide-*.png
/_*.txt
/_dbg.log
/out_dir
adr/
docs/*
docs/adr/
!/docs/
/docs/*
!/docs/agents/
/docs/agents/*
!/docs/agents/issue-tracker.md
!/docs/agents/domain.md
!/docs/superpowers/
!/docs/superpowers/specs/
!/docs/superpowers/specs/2026-10-25-analysis-workflow-design.md
/out*
# prises_verite: the TAKES and truths stay personal (wav/json), but the
# README committing the format and the non-drift fingerprints are tracked
/prises_verite/*
!/prises_verite/README.md
!/prises_verite/*.fingerprint.json
.superpowers