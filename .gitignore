# ===== Voix -> MIDI — ignore everything that is not a source =====
# Guided results review keeps no persistent state or generated output.

# --- Virtual environments ---
.venv/
venv/
env/
.venv.*/
ENV/

# --- Python cache ---
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
*.egg-info/
.eggs/

# --- Build / distribution ---
build/
dist/
wheels/
*.whl
pip-wheel-metadata/

# --- Coverage & quality tools ---
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml

# --- Machine-local dot-folders at the root ---
# The project's own dot-folder (.github/) is whitelisted just below; any other
# dot-file or dot-folder at the root is local data, never a source to version.
/.*
!/.github/
!/.gitignore
!/.gitattributes

# --- Local vendor material (machine-local, never versioned) ---
# Third-party interface instructions consulted while building, their lockfile
# and the offline hash check stay LOCAL: a clone does not carry them, and
# nothing in the repository reads them at runtime.
/vendor/
/vendor-lock.json
/scripts/check_vendor_lock.py

# --- Generated audio artifacts (analysis, demo, tests) ---
# Live take folders include immutable automatic/corrected reading archives.
*.wav
*.mp3
*.flac
*.ogg
*.m4a
*.aac
*.mid
*.midi
/live_*
prises_live/
# persisted vocal observations (analysis and replay share <take>.observation.npz)
*.npz

# --- Analysis outputs: scores + reports (export_result) ---
# Everything the pipeline writes with an arbitrary prefix:
# .musicxml / .pdf (MuseScore-LilyPond engraving) / .json / .csv
# Coherence, intonation registers, closed labels and live/final rates share these outputs.
*.musicxml
*.pdf
*.json
*.csv
# NB: the repo tracks no .json/.csv/.pdf today; should a JSON config file
# ever be tracked, negotiate it here with a !.

# exceptions: keep a possibly versioned sample audio, and the test
# artifacts reference (tests/reference/artifacts.json, see AGENTS.md):
# it is a fingerprint, not an analysis output — it must be tracked.
!tests/data/*.wav
!tests/reference/*.json
# the web page's own sources: its two-language labels and the frozen answers
# the JavaScript port replays (web/, see AGENTS.md) — the segmentation cases,
# the two YIN readings, and the intonation summary the visible line prints
!/web/strings.json
!/web/test/cases.json
!/web/test/yin.json
!/web/test/yin-rates.json
!/web/test/intonation.json
# NB: demo.wav stays ignored (make_demo.py regenerates it), so yin.json and
# yin-rates.json are the committed half of those comparisons and must NEVER be
# ignored.

# --- IDE / editors ---
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- Docker (local files, exported images) ---
*.tar
docker-compose.override.yml

# --- Personal notes ---
*.log

# --- Local runs (throwable root validation files) ---
/demo_out.*
/test68.*
/demo_docker.*
/demo_t1.*
/demo_t2.*
/demo_dbg.*
/_ours.pdf
/_via_py.pdf
# temporary captures and logs of the GUI / PDF checks (including home-screen layout)
/shot_*.png
# the Pages workflow's 1600 px screenshot (web/test/wide-shot.mjs)
/wide-*.png
# the home page's before/after captures: evidence for a UI review, not sources
/page-prise-*.png
# Root docs: only the two READMEs are sources. The local working files
# (AGENTS.md, CONTEXT.md, SKILLS.md, constraints.txt) and any other root
# .md/.txt — audit, diagnostic or proposal reports, the throwaway notes about
# the problems being worked on — stay machine-local: ignored, so git never
# proposes them (not selectable, not addable).
/AGENTS.md
/CONTEXT.md
/SKILLS.md
/constraints.txt
/*.md
/*.txt
!/README.md
!/README.fr.md
/_dbg.log
/out_dir
adr/
# All of docs/ is local working material (design notes, ADRs, dated reports,
# captures, engine-drift, superpowers): ignored, never proposed by git.
/docs/*
/out*
# prises_verite: the TAKES, truths and the format README stay personal (wav/json/md)
/prises_verite/*
!/prises_verite/*.fingerprint.json
.superpowers
# the web matrix job borrows Playwright at test time; the page stays dependency-free
/node_modules/
